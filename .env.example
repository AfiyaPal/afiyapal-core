# App
NEXT_PUBLIC_APP_URL=

# Database: replace with PostgreSQL/MySQL in production if preferred.
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
AUTH_SECRET=

# Homepage contact form protection
CONTACT_RATE_LIMIT_IP_PER_HOUR=5
CONTACT_RATE_LIMIT_EMAIL_PER_HOUR=3
CONTACT_MIN_FORM_SECONDS=2
CONTACT_IP_HASH_SECRET=

# Resend (for Vercel / serverless deployments — uses HTTPS)
RESEND_API_KEY=
RESEND_FROM=
CONTACT_EMAIL_TO=

# ─── SMTP (uncomment when self-hosting on a dedicated server) ───
# Use when hosting on Truehost, DigitalOcean, AWS EC2, etc.
# These servers allow outbound SMTP on ports 465/587.
# When switching, also update server/services/email-service.ts
# (see instructions in that file).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
